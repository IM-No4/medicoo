EXPO_PUBLIC_API_BASE_URL=https://backend.medicoo.in
# For local dev, comment the line above and uncomment the one below instead.
# Using localhost + `adb reverse tcp:5000 tcp:5000` (USB) instead of the PC's
# LAN IP - the dev PC's WiFi is a phone hotspot with client isolation, which
# blocks device-to-device traffic even on the same network. adb reverse
# forwards the Android phone's own localhost:5000 to the PC over the USB
# cable, sidestepping WiFi entirely. Must be re-run after every USB
# reconnect/adb server restart - see the reminder further down.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Build-time only (not EXPO_PUBLIC_ - must not end up in the JS bundle).
# Restrict this key in Google Cloud Console to this app's Android package
# name/SHA-1 and iOS bundle ID - it ships inside the compiled native app
# for on-device map tile rendering and cannot be proxied through the backend.
GOOGLE_MAPS_API_KEY_NATIVE=AIzaSyA4Vzs1VRiOO0Sc4MPFDwgRVcVdmfeJSqQ

EXPO_PUBLIC_WEB_APP_URL=https://medicoo.in
EXPO_PUBLIC_BLOG_URL=https://medicoo.in/blog
EXPO_PUBLIC_DONATE_BLOOD_URL=https://medicoo.in/donate-blood
