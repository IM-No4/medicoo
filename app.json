{
  "expo": {
    "name": "medicoo",
    "slug": "medicoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "medicoo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tez", "phonepe", "paytmmp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/images/android-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.medicoo.consumer",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./firebase/google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "@react-native-firebase/crashlytics",
      "@react-native-community/datetimepicker",
      [
        "react-native-ble-plx",
        {
          "bluetoothAlwaysPermission": "Medicoo uses Bluetooth to connect to your health monitoring devices."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Medicoo needs access to your photos to let you upload prescriptions, reports, and your profile picture.",
          "cameraPermission": "Medicoo needs access to your camera to let you scan and upload prescriptions and documents.",
          "microphonePermission": "Medicoo needs access to your microphone for audio and video consultations with doctors."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Medicoo needs your location to find nearby pharmacies, doctors, and delivery partners, and to set your delivery address."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Medicoo needs access to your contacts so you can quickly add a family member or delivery address."
        }
      ],
      "./plugins/withRazorpayCheckoutTheme.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
